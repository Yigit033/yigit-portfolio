# Normalize line endings to LF in the repository and on checkout.
# Prettier is configured with endOfLine: "lf" — without this, Windows
# checkouts get CRLF and every file fails `npm run format:check`.
* text=auto eol=lf

# Binary assets — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.woff  binary
*.woff2 binary
*.webm binary
*.mp4 binary
