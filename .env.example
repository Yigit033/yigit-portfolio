# Contact form delivery (app/api/contact/route.ts)
#
# Without RESEND_API_KEY the form stays up but reports that messaging is not
# configured and points visitors at the direct e-mail address, rather than
# accepting a message it cannot deliver.
#
# 1. Create a free account at https://resend.com (100 e-mails/day)
# 2. Create an API key and paste it below
# 3. Add the same variable in the Vercel project settings for production
RESEND_API_KEY=

# Where submissions are delivered. Defaults to contactInfo.email in data/social.ts.
CONTACT_TO_EMAIL=

# Sender address. Resend requires a verified domain for a custom address;
# onboarding@resend.dev works out of the box and is the default.
# Once yigittilaver.com is verified in Resend, use e.g. contact@yigittilaver.com
CONTACT_FROM_EMAIL=
