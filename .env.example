# Contact form delivery (app/api/contact/route.ts)
#
# Copy this file to .env.local and fill in RESEND_API_KEY. The other two are
# optional — leave them blank and the defaults below apply. Restart the dev
# server after changing any of these; Next.js only reads .env files on boot.
#
# Without RESEND_API_KEY the form still renders, but reports that messaging is
# not configured and points visitors at the direct e-mail address, rather than
# accepting a message it cannot deliver.

# ── Required ──────────────────────────────────────────────────────────
# Free account at https://resend.com — 100 e-mails/day, no card needed.
# Create an API key and paste it here. Add the same variable in the Vercel
# project settings for production.
RESEND_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────
# Where submissions are delivered.
# Leave blank → contactInfo.email in data/social.ts (yigittilaver2000@gmail.com)
CONTACT_TO_EMAIL=

# Sender address shown on the e-mail.
# Leave blank → onboarding@resend.dev, which works with no setup.
#
# Note: while using onboarding@resend.dev, Resend only lets you send to the
# address your Resend account is registered with. That is fine here, because
# messages go to your own inbox. To send from contact@yigittilaver.com instead,
# verify the domain in Resend first, then put that address here.
CONTACT_FROM_EMAIL=
